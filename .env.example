# Vercel: Project → Settings → Environment Variables — set DATABASE_URL for
# Production (and Preview). Required for postinstall `prisma generate` and vercel-build.

# --- Supabase + Vercel (important) ---
# Direct host `db.PROJECT_REF.supabase.co:5432` often fails from Vercel with P1001.
# Use the Session pooler URI from Supabase Dashboard → Connect → "Session pooler"
# (host like aws-0-REGION.pooler.supabase.com, port 5432).
#
# Example shape (replace PROJECT_REF, REGION, PASSWORD):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
#
# For high-traffic serverless later: use Transaction pooler (6543 + ?pgbouncer=true) for
# DATABASE_URL and set MIGRATE_DATABASE_URL to the Session pooler URI for builds only.
# MIGRATE_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Generic Postgres (local or any reachable host) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Supabase client (Storage/Auth)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

SESSION_SECRET="replace-with-32+-char-random-string"
PRISMA_CLIENT_ENGINE_TYPE="library"

MARGINAL_TAX_RATE="0.24"
