# Local (SQLite) — path must match your machine or use `file:./dev.db` relative to prisma folder context
DATABASE_URL="file:./dev.db"

# Production (Railway Postgres) — replace with your Railway connection string when deploying
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# Supabase (optional — client SDK for Storage/Auth later; DB can still be Prisma + DATABASE_URL)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New dashboard keys (preferred):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

SESSION_SECRET="replace-with-32+-char-random-string"
PRISMA_CLIENT_ENGINE_TYPE="library"

# Illustrative tax savings on Reports (0–1 scale, e.g. 0.24 = 24% marginal rate)
MARGINAL_TAX_RATE="0.24"
