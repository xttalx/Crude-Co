# PostgreSQL (required) — local dev and Vercel builds use this.
# Supabase: Project Settings → Database → Connection string → URI (use Session mode / pooler for app;
# for `prisma migrate deploy` use Direct connection if the pooler rejects DDL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Supabase client (Storage/Auth; app DB remains Prisma + DATABASE_URL)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New dashboard keys (preferred):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

SESSION_SECRET="replace-with-32+-char-random-string"
PRISMA_CLIENT_ENGINE_TYPE="library"

# Illustrative tax savings on Reports (0–1 scale, e.g. 0.24 = 24% marginal rate)
MARGINAL_TAX_RATE="0.24"
